; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PokemonGodotVersion"
run/main_scene="uid://bibf1kjdrfikk"
config/features=PackedStringArray("4.4", "C#", "GL Compatibility")
config/icon="res://icon.svg"
run/size/viewport_height=720
run/size/viewport_width=1280
run/size/resizable=false
run/size/mode=0

[autoload]

Globals="*res://scripts/core/Globals.cs"
Signals="*res://scripts/core/Signals.cs"
GameState="*res://scripts/core/GameState.cs"
SceneTransition="*res://scripts/core/SceneTransition.cs"
MenuController="*res://scripts/ui/MenuController.cs"
SaveManager="*res://scripts/core/SaveManager.cs"
Audio="*res://audio.tscn"

[display]

window/size/viewport_width=1240
window/size/viewport_height=720
window/size/resizable=false
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="PokemonSharp"

[editor_plugins]

enabled=PackedStringArray("res://addons/MoveImporter/plugin.cfg")

[input]

use={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

textures/canvas_textures/default_texture_filter=0
